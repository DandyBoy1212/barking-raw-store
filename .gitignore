# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds only blank placeholders and is the only
# record of which variables the app actually needs. Keeping it untracked meant
# every fresh setup rediscovered the missing ones the hard way.
!.env.example

# secrets / credentials (never commit)
service-account.json
credentials.json
*.serviceaccount.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# git worktrees. Each one is its own checkout, so committing this directory would
# write a gitlink and leave a broken submodule reference on the branch.
.claude/worktrees/

# Barking Raw Store — environment variables
# Copy to .env.local for local dev. NEVER commit real values.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (from Michaela's Stripe account) ---
# Use test keys (sk_test_... / pk_test_...) until go-live, then swap to live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Firebase Admin (reuse the existing barking-raw project) ---
# Paste the FULL service-account JSON on one line, OR set GOOGLE_APPLICATION_CREDENTIALS
# to a path. The store uses collections prefixed store_* so it never touches the
# training app's data.
FIREBASE_SERVICE_ACCOUNT=
# Default Storage bucket, required for product photo upload in the admin
# (see getBucket in src/lib/firebase-admin.ts). No gs:// prefix.
FIREBASE_STORAGE_BUCKET=

# --- Firebase web SDK (client side) ---
# Required by src/lib/firebase-client.ts, which the /login and /login/complete
# pages import. Without them the sign-in page throws auth/invalid-api-key at
# module evaluation, before any UI renders.
# Get them from: Firebase console > Project settings > Your apps > Web app >
# SDK setup and configuration. These are public by design (they ship in the
# browser bundle); access is controlled by security rules and the authorised
# domains list, not by keeping them secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Google Sheet fulfilment ---
# The spreadsheet ID from its URL. Share the sheet with the service-account email
# (…@….iam.gserviceaccount.com) as an Editor. Tab must be named "Orders".
FULFILMENT_SHEET_ID=
# Optional: separate service account for Sheets (defaults to FIREBASE_SERVICE_ACCOUNT)
GOOGLE_SHEETS_SERVICE_ACCOUNT=

# --- Email (Resend) for abandoned-cart + daily digest ---
RESEND_API_KEY=
EMAIL_FROM=Barking Raw <hello@barkingraw.dog>
OWNER_EMAIL=

# --- Cron protection (Vercel sets this header automatically when set) ---
CRON_SECRET=

# --- The stall (D.3) ---
# Short staff PIN for /stall on market days. Compared server-side only, never sent
# to the browser. Unset means the stall form is off (staff sessions still get in).
# Make it 6+ characters: the throttle slows online guessing, and the session key
# mixes in FIREBASE_SERVICE_ACCOUNT, but a longer PIN costs Michaela nothing.
STALL_PIN=
